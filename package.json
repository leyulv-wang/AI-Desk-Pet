{
  "name": "desktop-pet",
  "version": "0.2.0",
  "private": true,
  "description": "二次元 AI 桌宠 · Live2D 形象 + 文字对话 + 本地 GPT-SoVITS 语音（芙宁娜）",
  "main": "src/main.js",
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "test:regressions": "node --test scripts/test-regressions.cjs",
    "test:ui": "node scripts/test-ui.mjs",
