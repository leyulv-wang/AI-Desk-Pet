    "model": "node scripts/install-model.mjs",
    "check": "node scripts/check-llm.mjs",
    "start": "electron .",
    "pet:start": "pwsh -NoProfile -File scripts/pet-ctl.ps1 start",
    "pet:stop": "pwsh -NoProfile -File scripts/pet-ctl.ps1 stop",
    "pet:status": "pwsh -NoProfile -File scripts/pet-ctl.ps1 status",
    "dev": "electron . --dev",
    "voice": "node scripts/start-voice.mjs",
    "sing:setup": "node scripts/sing-setup.mjs",
    "sing": "node scripts/sing-run.mjs",
    "test:singing": "node scripts/test-singing.mjs",
    "probe:sing": "node scripts/probe-singing-play.mjs",
    "pet:static": "node scripts/make-static-pet.mjs",
    "check:renderers": "node scripts/check-pet-renderers.mjs",
    "check:wiring": "node scripts/check-wiring.mjs",
    "voice:test": "node scripts/test-tts.mjs",
    "voice:emo": "node scripts/test-voice-select.mjs",
    "voice:build": "node scripts/vendor-voice-clips.mjs && node scripts/build-voice-library.mjs",
    "voice:probe": "node scripts/probe-tts-cache.mjs",
    "voice:lock": "node scripts/probe-reply-prosody.mjs",
    "voice:pitch": "node scripts/measure-prosody.mjs",
    "diag:prosody": "node scripts/diagnose-prosody.mjs",
    "diag:ref": "node scripts/probe-ref-consistency.mjs",
    "audition": "node scripts/audition-ref.mjs",
    "check:audition": "node scripts/check-audition.mjs",
    "check:fixedref": "node scripts/check-fixed-ref.mjs",
    "test:splitter": "node scripts/test-splitter.mjs",
    "test:spoken": "node scripts/test-spoken.mjs",
    "test:lore": "node scripts/test-lore.mjs",
    "diag:dud": "node scripts/diagnose-dud.mjs",
    "probe:segments": "node scripts/probe-segments.mjs",
    "card:inspect": "node scripts/inspect-card.mjs",
    "card:lore": "node scripts/import-card-lore.mjs",
    "eval:persona": "node scripts/eval-persona.mjs",
    "test:memory": "node scripts/test-memory.mjs",
    "test:history": "node scripts/test-history.mjs",
    "test:temporal": "node scripts/test-temporal.mjs",
    "test:decay": "node scripts/test-decay-loop.mjs",
    "bench:embedding": "node scripts/bench-embedding.mjs",
    "bench:quality": "node scripts/bench-embedding-quality.mjs",
    "bench:models": "node scripts/bench-models.mjs",
    "compare:tiers": "node scripts/compare-tts-tiers.mjs",
    "compare:minimax": "node scripts/compare-minimax.mjs",
    "clone:source": "node scripts/prepare-clone-audio.mjs",
    "check:clone": "node scripts/check-clone-identity.mjs",
    "measure:wavs": "node scripts/measure-wavs.mjs",
    "test:dud": "node scripts/test-dud-guard.mjs",
    "check:dudmetric": "node scripts/check-dud-metric.mjs",
    "inspect:wav": "node scripts/inspect-wav-format.mjs",
    "timbre:check": "node scripts/timbre-vs-real.mjs",
    "tune:mimo": "node scripts/tune-mimo-vs-real.mjs",
    "retry:take": "node scripts/retry-take.mjs",
    "compare:mimo": "node scripts/compare-mimo.mjs"
  },
  "devDependencies": {
    "electron": "^44.4.3"
  }
}
